[Unit]
Description=Plane ITSM Backend (docker-compose-local: db, redis, mq, minio, api-rs, worker-rs, beat-rs)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/ghifari/plane-for-itsm
Environment=COMPOSE_DOCKER_CLI_BUILD=1
Environment=DOCKER_BUILDKIT=1
ExecStart=/usr/bin/docker compose -f /home/ghifari/plane-for-itsm/docker-compose-local.yml up -d --build
ExecStop=/usr/bin/docker compose -f /home/ghifari/plane-for-itsm/docker-compose-local.yml down
ExecReload=/usr/bin/docker compose -f /home/ghifari/plane-for-itsm/docker-compose-local.yml up -d --build
TimeoutStartSec=1800
TimeoutStopSec=120
TimeoutReloadSec=1800

[Install]
WantedBy=default.target
