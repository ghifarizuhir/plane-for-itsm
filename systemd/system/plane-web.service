[Unit]
Description=Plane ITSM Web (3000) - pnpm --filter=web dev --host 0.0.0.0
After=plane-backend.service network-online.target
Wants=plane-backend.service
Wants=network-online.target

[Service]
Type=simple
User=ghifari
Group=ghifari
WorkingDirectory=/home/ghifari/plane-for-itsm
Environment=NODE_ENV=development
Environment=PATH=/home/ghifari/.nvm/versions/node/v24.16.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/ghifari/.nvm/versions/node/v24.16.0/bin/pnpm --filter=web dev --host 0.0.0.0
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=plane-web
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
